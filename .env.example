# Google Cloud OAuth 2.0 Credentials (for permanent/persistent document history queries)
# Create a Web Client ID in the Google Cloud Console with Drive API enabled.
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_permanent_refresh_token_here (starts with 1//...)
